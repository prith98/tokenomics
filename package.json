{
  "name": "tokenomics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LLM Gateway & Control Plane — token-aware proxy, policy engine, semantic cache",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "node --import tsx src/index.ts",
    "build": "tsc && npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "frontend:install": "npm --prefix frontend install",
    "typecheck": "tsc --noEmit && npm --prefix frontend run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "js-tiktoken": "^1.0.15",
    "openai": "^4.67.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "uuid": "^10.0.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
