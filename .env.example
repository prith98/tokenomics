# --- Provider credentials ---
# Leave empty to run in mock mode (no real API calls).
OPENAI_API_KEY=

# Force mock mode even when keys are present.
# MOCK_MODE=true

# Mock provider tunables
# MOCK_FAILURE_RATE=0.0      # 0.0 - 1.0; chance a mock call returns 500
# MOCK_STREAM_DELAY_MS=20    # per-chunk delay in mock streaming

# --- Server ---
PORT=8080
LOG_LEVEL=info

# --- Storage ---
SQLITE_PATH=./data/gateway.db

# --- Semantic cache (P3) ---
# Connection string for Redis Stack (set via `npm run docker:up`).
# Leave unset to disable cache silently — gateway still runs without Redis.
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true

# --- Defaults applied when request omits attribution headers ---
DEFAULT_TEAM_ID=default
DEFAULT_FEATURE_ID=default
DEFAULT_ENVIRONMENT=development
